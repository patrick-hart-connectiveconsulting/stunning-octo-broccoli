{
  "name": "media-manager",
  "version": "0.5.0",
  "private": true,
  "description": "A lightweight, dependency-free media library and data streams API (events, posts, products…) inspired by Strapi",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node src/server.js --token=dev-token",
    "dev": "node --watch src/server.js",
    "dev:local": "node --watch src/server.js --token=dev-token",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
